# ============================================================
# 消防工程 AI 电子课本 · API 配置模板
# ------------------------------------------------------------
# 使用方法（在项目根目录下执行）：
#     Copy-Item 00_配置\.env.example 00_配置\.env
#   然后把下面的 DEEPSEEK_API_KEY 改成你的真实 Key。
#
# 注意：.env 里不要加引号、不要在等号两边留空格。
#       本文件（.env.example）可以放心保留，不要填真实 Key。
#       `.env` 已被 .gitignore 排除，不会进版本库。
# ============================================================

# 【必填】DeepSeek API Key —— 用于 M4 结构化 / M5 校验 / M6 复习产物
DEEPSEEK_API_KEY=sk-替换为你的真实Key

# 【一般不改】接口地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【默认模型】flash 便宜且够用，本项目 95% 的调用都用它
DEEPSEEK_MODEL=deepseek-v4-flash

# 【可选】仅在"一次定全局"的关键节点临时切换（如知识骨架设计、跨科冲突消解）
# 用法：在脚本里显式传 model="...pro"，或临时改这里再改回来
DEEPSEEK_MODEL_STRONG=deepseek-v4-pro
